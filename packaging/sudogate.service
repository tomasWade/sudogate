[Unit]
Description=SudoGate review server (ssh client side)
Documentation=https://github.com/tomasWade/sudogate

[Service]
ExecStart=%h/.local/bin/sudogate-server serve
Restart=on-failure
# process：stop/restart 只信号主进程，cgroup 内其余进程一律不碰——
# 桌面审批弹窗（server spawn 的 kitty，Setsid 独立会话但仍在 cgroup
# 内）按设计要独立存活，server 重启不得闪窗。默认 control-group 与
# mixed 都会在主进程退出后清理剩余进程、杀掉弹窗。转发通道不受影响：
# 正常退出走 Shutdown，崩溃由 Pdeathsig 兜底。
KillMode=process
# 崩溃不落 core dump：进程内存里有待 GC 的密码字符串与私钥，
# 内存快照落盘 = 密钥材料落盘。排障靠 journal，不靠 core。
LimitCORE=0

[Install]
WantedBy=default.target
